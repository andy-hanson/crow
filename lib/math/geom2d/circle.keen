import
	keen/math/vec
	keen/math/geom2d/aa-rect

+circle32 record
	center vec2-32
	radius float32
+rect-containing aa-rect32(a circle32)
	left: a.center.x - a.radius
	right: a.center.x + a.radius
	bottom: a.center.y - a.radius
	top: a.center.y + a.radius
| Circle sharing {a}'s center that is as large as possible without exceeding it
+circle-inside circle32(a aa-rect32)
	center: a.center
	radius: a.shorter-side / 2
