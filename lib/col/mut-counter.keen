+mut-counter[k] record mut
	-inner mut nat mut[k]

+list-new[k] k mut-counter(a k[]) k key
	a.to

+to[k] k mut-counter(values k[]) k key
	res k mut-counter = inner: ()
	res ~~= values
	res

+move-to[k] nat mut[k](a k mut-counter) k key
	res = a.inner
	a.inner := ()
	res

+subscript[k] nat(a k mut-counter, value k) k key
	a.inner[value] else 0

+ ~=[k] void(a k mut-counter, value k) k key
	a.inner[value] := a[value] + 1

+ ~~=[k] void(a k mut-counter, values k array-view) k key
	for v in values
		a ~= v

+some[k] bool(a k mut-counter, f bool mut(key k, count nat)) k key
	some a.inner, f

+get-and-incr[k] nat(a k mut-counter, key k) k key
	res = a[key]
	a ~= key
	res
