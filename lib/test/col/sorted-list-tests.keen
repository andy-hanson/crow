import
	keen/col/sorted-list

test
	a (nat64, string) sorted-list = ()
	a is ()
	any a is false
	size a is 0

	b = a ~ (1, "one")
	b is ((1, "one"),)
	size b is 1
	b[1] is ("one",)

	c = b ~ (2, "two")
	c is ((1, "one"), (2, "two"))
	size c is 2
	c[1] is ("one",)

	d = c ~ (1, "uno")
	d isnt c
	d is (1, "one"), (1, "uno"), (2, "two")
	size d is 3
	d[1] is ("one", "uno")
	d[3] is ()
	first d is (1, "one")
	last d is (2, "two")

	keys d is (1, 1, 2)
