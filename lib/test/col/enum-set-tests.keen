import
	keen/col/enum-map
	keen/col/enum-set

e enum
	x
	y
	z

test
	a e enum-set = ()
	is-empty a is true
	is-full a is false
	size a is 0
	a.to::e[] is ()
	a[x] is false

	ay = a | y
	ay is y,
	ay.to::e[] is y,
	ay[x] is false
	ay[y] is true
	ay[z] is false
	is-empty ay is false
	is-full ay is false
	size ay is 1

test
	a e enum-set = all
	is-empty a is false
	is-full a is true
	size a is 3
	a is all
	a.to::e[] is x, y, z

test
	xz e enum-set = x, z
	j json = "x", "z"
	to::(e enum-set) j is xz
	to::json xz is j

test
	a (e, nat) enum-map =
		- x, 2
		- y, 3
		- z, 4
	to-set a, it.b.is-even is x, z

| Ensuring that '&' shrinks the bits array down so that '==' works
test
	a e enum-set = ()
	b e enum-set = x, y, z
	a & b is a

test
	a e33 enum-set = x7, x11
	b e33 enum-set = x7, x33
	a & b is x7,
	a | b is x7, x11, x33
	b | x0 is x0, x7, x33
	to::e33[] b is x7, x33

| Test with more than 32 members so 'bits' will require multiple values
-e33 enum
	x0
	x1
	x2
	x3
	x4
	x5
	x6
	x7
	x8
	x9
	x10
	x11
	x12
	x13
	x14
	x15
	x16
	x17
	x18
	x19
	x20
	x21
	x22
	x23
	x24
	x25
	x26
	x27
	x28
	x29
	x30
	x31
	x32
	x33
