import
	keen/col/stack

test
	a nat64 stack = ()
	any a is false
	size a is 0
	a.to::nat64[] is ()
	a.peek is ()

	b = a ~ 1
	b.to::nat64[] is (1,)
	b.peek is 1
	b-popped = pop! b
	b.pop!.a.to::nat64[] is ()
	b-popped.b is 1
	any b is true
	size b is 1

	c = b ~ 2
	c.to::nat64[] is (1, 2)
	c.peek is 2
	c-popped = c.pop!
	c-popped.a.to::nat64[] is (1,)
	c-popped.b is 2

	d = c ~ 3
	d.to::nat64[] is (1, 2, 3)

	map::nat64[] d, {it} is (1, 2, 3)
	d.reverse.to::nat64[] is (3, 2, 1)
