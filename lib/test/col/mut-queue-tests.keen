import
	keen/col/mut-queue

test
	a nat mut-queue = ()
	forbid any a
	a.size is 0
	a.to::nat[] is ()

	a ~= 1
	a.to::nat[] is (1,)
	assert any a
	a.size is 1
	dequeue a is 1
	forbid any a
	a.size is 0
	dequeue a is ()
	forbid any a

	a ~~= (2, 3, 4)::nat[]
	a.size is 3
	to::nat[] a is 2, 3, 4
	dequeue a is 2
	dequeue a is 3
	dequeue a is 4
	dequeue a is ()
