import
	keen/col/queue

test
	a nat64 queue = ()
	any a is false
	size a is 0
	a.to is ()
	forbid dequeue a

	b = a ~ 1
	b.to::nat64[] is (1,)
	bx, br = dequeue! b
	bx is 1
	any br is false

	c = b ~ 2
	c.to::nat64[] is (1, 2)
	cx, cr = dequeue! c
	cx is 1

	cr.to::nat64[] is (2,)
	crx, crr = dequeue! cr
	crx is 2
	any crr is false

	d = c ~ 3
	d.to::nat64[] is (1, 2, 3)

	map::nat64[] d, it + 10 is (11, 12, 13)
