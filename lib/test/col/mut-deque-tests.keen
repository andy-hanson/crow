import
	../../col/mut-deque

test
	a nat mut-deque = ()
	a.pop-left is ()
	a.pop-right is ()
	verify a, (), ""
	push 1::nat, a
	verify a, (1,), "<-R _ L-> 1"
	push a, 2
	verify a, (1, 2), "2 <-R L-> 1"

	a-copy = copy a
	verify a-copy, (1, 2), "<-R L-> 1 2"

	a.pop-right is 2
	verify a, (1,), "<-R _ L-> 1"

	a.pop-right is 1
	verify a, (), "_ _"

	push a, 1
	verify a, (1,), "L-> 1 <-R _"

	push 2::nat, a
	verify a, (2, 1), "1 <-R L-> 2"

	push 3::nat, a
	verify a, (3, 2, 1), "2 1 <-R _ L-> 3"

-verify void(a nat mut-deque, expected nat[], expected-dbg string)
	a.peek-left is unless is-empty expected then expected[0]
	a.peek-right is unless is-empty expected then expected[end - 1]
	a.size is expected.size
	a.to::nat[] is expected
	map::nat[] a, {it} is expected
	a.dbg is expected-dbg

test
	a nat mut-deque = 1, 2, 3
	results nat[] = for x in a
		any a is true
		size a is 3
		to::nat[] a is 1, 2, 3
		to::nat[] copy a is 1, 2, 3
		map::nat[] a, {it} is 1, 2, 3
		x
	results is 1, 2, 3
	test-cant-do-while-iterating {push 0::nat, it}
	test-cant-do-while-iterating {push it, 4}
	test-cant-do-while-iterating {pop-left it}
	test-cant-do-while-iterating {pop-right it}
	test-cant-do-while-iterating {clear it}

-test-cant-do-while-iterating[t] void(f t mut(a nat mut-deque))
	xs nat mut-deque = 0, 1, 2
	try
		for _ in xs
			_ = f[xs]
		should-throw
	catch as was-locked
		()
	to::nat[] xs is 0, 1, 2
