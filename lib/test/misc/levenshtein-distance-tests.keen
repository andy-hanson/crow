import
	keen/misc/levenshtein-distance

test
	do-test (), (), 0

	do-test (1,), (), 1
	do-test (1,), (1,), 0
	do-test (1,), (2,), 1
	do-test (1,), (1, 1), 1
	do-test (1,), (1, 2), 1
	do-test (1,), (2, 1), 1
	do-test (1,), (2, 2), 2

	do-test (1,), (1, 1, 1), 2
	do-test (1,), (0, 0, 1), 2
	do-test (1,), (1, 0, 0), 2
	do-test (1,), (0, 1, 0), 2
	do-test (1,), (0, 0, 0), 3

	do-test (1, 2), (1, 2), 0
	do-test (1, 2), (0, 2), 1
	do-test (1, 2), (1, 0), 1
	do-test (1, 2), (2, 1), 2
	do-test (1, 2), (0, 1, 2), 1
	do-test (1, 2), (1, 0, 2), 1
	do-test (1, 2), (1, 2, 3), 1

	do-test (1, 2, 3), (1, 2, 3), 0
	do-test (1, 2, 3), (0, 2, 3), 1
	do-test (1, 2, 3), (1, 0, 3), 1
	do-test (1, 2, 3), (1, 2, 0), 1
	do-test (1, 2, 3), (1, 3, 2), 2
	do-test (1, 2, 3), (2, 1, 3), 2
	do-test (1, 2, 3), (2, 3, 1), 2
	do-test (1, 2, 3), (0, 0, 0), 3

-do-test void(a nat[], b nat[], expected nat)
	levenshtein-distance a, b is expected
	levenshtein-distance b, a is expected
