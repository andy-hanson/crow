import
	../../../model/ast
	../../../model/model
	../../../util/util
	../allocators
	../check-ctx
	../expr-ctx
	../inferring-type

candidates-for-diag called-decl[](candidates candidates)
	sort map candidates, it.called

get-all-candidates-for-diag called-decl[](fun-name fun-name) check-expr-ctx
	sort with out in build
		each-fun-in-expr-scope-with-name fun-name.regular-name, {out ~= it}
		match fun-name
		as name-and-arity
			()
		as fun-name-list-new
			each-fun-in-expr-scope list-new-1, {if as-list-new it then out ~= it}

with-candidates[t] t
	funs funs-in-scope
	fun-name fun-name
	return-type type?
	arg0-type type?
	initial-filter bool mut(x candidate)
	f t mut(candidates candidates)
do check-ctx, common-types
	candidates, restore = trusted allocate-candidates
	finally trusted free-candidates candidates, restore
	add-initial-candidates candidates, funs, fun-name.regular-name, return-type, arg0-type, initial-filter
	match fun-name
	as name-and-arity
		()
	as fun-name-list-new
		each-fun-in-scope funs, list-new-1, of called
			do if element-type = as-list-new called
			candidate = init-variadic-candidate called, element-type
			do if initial-filter[candidate]
			candidates ~= candidate
	f[candidates]

-add-initial-candidates void
	candidates candidate stack-array
	funs funs-in-scope
	name-and-arity name-and-arity
	return-type type?
	arg0-type type?
	initial-filter bool mut(x candidate)
do check-ctx, common-types
	each-fun-with-types funs, name-and-arity, return-type, arg0-type, of called
		candidate = init-candidate called
		do if initial-filter[candidate]
		candidates ~= candidate

| Returns `t` if the signature matches `(values t[])`
as-list-new type?(called called-decl)
	as-array only! called.param-types

| Returns `t` if the signature matches `(names symbol[], values t[])`.
-as-named-new type?(called called-decl) common-types
	names, values = only2! called.param-types
	do if names.as-array == symbol
	as-array values

each-candidate-with-signature void
	funs funs-in-scope
	name-and-arity name-and-arity
	signature return-and-param-types
	f void mut(x candidate)
do check-ctx
	any mut = false
	each-fun-with-exact-signature funs, name-and-arity, signature, of fun
		any := true
		f[init-candidate fun]
	# If we had an exact match, ignore other candidates
	unless any
		each-candidate funs, name-and-arity, f

each-candidate void(funs funs-in-scope, name-and-arity name-and-arity, f void mut(x candidate)) check-ctx
	each-fun-in-scope funs, name-and-arity, of called
		f[init-candidate called]
	if name-and-arity == new-0
		each-fun-in-scope funs, list-new-1, of called
			if element-type = as-list-new called
				f[init-variadic-candidate called, element-type]

funs-in-scope record
	fun-specs specs
	funs-map funs-map
funs-in-expr-scope funs-in-scope() expr-ctx
	the-specs, funs-map

-each-fun-in-expr-scope-with-name void(fun-name symbol, f void mut(x called-decl)) check-expr-ctx
	each-fun-in-scope-with-name funs-in-expr-scope, fun-name, f
each-fun-in-scope-with-name void(a funs-in-scope, fun-name symbol, f void mut(x called-decl)) check-ctx
	for sig in a.fun-specs.instantiated-sigs
		if sig.name == fun-name
			f[sig]
	for fun in all-with-name a.funs-map, fun-name
		f[fun]
	for exports in the-imports-and-re-exports
		for fun in all-with-name exports.funs, fun-name
			f[fun]
-each-fun-in-expr-scope void(name-and-arity name-and-arity, f void mut(x called-decl)) check-expr-ctx
	each-fun-in-scope funs-in-expr-scope, name-and-arity, f
each-fun-in-scope void(a funs-in-scope, name-and-arity name-and-arity, f void mut(x called-decl)) check-ctx
	for sig in a.fun-specs.instantiated-sigs
		if sig.name-and-arity == name-and-arity
			f[sig]
	for fun in all-with-name-and-arity a.funs-map, name-and-arity
		f[fun]
	for exports in the-imports-and-re-exports
		for fun in all-with-name-and-arity exports.funs, name-and-arity
			f[fun]
| This only loosely matches return-type, so caller must re-check
each-fun-with-types void
	a funs-in-scope
	name-and-arity name-and-arity
	return-type type?
	arg0-type type?
	f void mut(x called-decl)
do check-ctx, common-types
	for sig in a.fun-specs.instantiated-sigs
		if sig.name-and-arity == name-and-arity
			f[sig]
	each-with-name-and-types a.funs-map, name-and-arity, return-type, arg0-type, f[it]
	for exports in the-imports-and-re-exports
		each-with-name-and-types exports.funs, name-and-arity, return-type, arg0-type, f[it]
each-named-new-fun void
	funs funs-in-scope
	# This is here just as an optimization to filter the set of functions.
	# Caller must still check that candidate types match.
	expected expected
	names symbol[]
	f void mut(x candidate, used-params which-params)
do check-ctx, common-types
	emit-fun = of fun fun-decl
		if used-params = names-match fun, names
			f[fun.init-candidate, used-params]

	if choices = expected-return-types-for-named-new expected
		for return-type in choices
			each-new-fun funs.funs-map, return-type, emit-fun
			for exports in the-imports-and-re-exports
				each-new-fun exports.funs, return-type, emit-fun
	else
		each-new-fun funs.funs-map, emit-fun

	each-fun-in-scope funs, named-new-2, of called
		if element-type = as-named-new called
			f[(init-variadic-candidate called, element-type), calls-named-new]

all-new-funs-for-diag fun-decl[](funs funs-in-scope) check-ctx
	do with out in build
	each-new-fun funs.funs-map, of fun
		out ~= fun
	for exports in the-imports-and-re-exports
		each-new-fun exports.funs, of fun
			out ~= fun
	# Ignore 'named-new', if one existed it would have been called

-names-match which-params?(fun fun-decl, names symbol[])
	if names.size < fun.params.size and fun.param-defaults
		which-params nat mut[] = ()
		name-index mut nat = 0
		do if every fun.params.size, of param-index
			if name-index < names.size and fun.params[param-index].name == names[name-index]
				which-params ~= param-index
				name-index +:= 1
				true
			else
				fun.param-defaults[param-index]
		if name-index == names.size
			res = to::indices move-to::nat[] which-params
			if is-range res then does-not-skip-params else res
	elif arrays-correspond fun.params, names, of param, name then param.name == name
		does-not-skip-params

| {indices} means we are calling a 'new' function and using the corresponding params.
| The array will be sorted.
which-params union(indices, does-not-skip-params, calls-named-new)
| This still permits omitting params on the end
does-not-skip-params record
calls-named-new record

each-fun-with-exact-signature void
	a funs-in-scope
	name-and-arity name-and-arity
	signature return-and-param-types
	f void mut(x called-decl)
do check-ctx
	for sig in a.fun-specs.instantiated-sigs
		if sig.name-and-arity == name-and-arity and sig.return-and-param-types == signature
			f[sig]
	each-with-name-and-signature a.funs-map, name-and-arity, signature, f[it]
	for exports in the-imports-and-re-exports
		each-with-name-and-signature exports.funs, name-and-arity, signature, f[it]

allow-implicit-conversions enum(no-conversions, allow-conversions)
test-candidate-for-spec-sig bool
	spec-impl candidate
	expected return-and-param-types
	context type-context
	conv allow-implicit-conversions
do common-types
	return-conv implicit-conversions = match conv
	as no-conversions
		exact
	as allow-conversions
		a-to-b
	expected-return = type-and-maybe-context expected.return-type, context
	do if match-types spec-impl.return-type-and-context, expected-return, return-conv
	every expected.param-types.with-index, of arg-idx, param-type
		expected-param = type-and-maybe-context param-type, context
		test-candidate-param-type spec-impl, arg-idx, expected-param, no-conversions

return-type-and-context type-and-context(a candidate)
	type-and-maybe-context a.called.return-type, a.inferring-type-args

| Also does type inference on the candidate
test-candidate-return-type type-match-kind?(expected expected, candidate candidate) common-types
	match-expected-vs-return-type-no-diagnostic expected, candidate.return-type-and-context
| Also does type inference on the candidate
test-candidate-param-type type-match-kind?
	candidate candidate
	arg-idx nat32
	actual-arg-type type-and-context
	conversions allow-implicit-conversions
do common-types
	match-types (get-candidate-expected-parameter-type candidate, arg-idx), actual-arg-type, match conversions
	as allow-conversions
		b-to-a
	else
		exact

get-candidate-expected-parameter-type type-and-context(candidate candidate, arg-index nat32)
	match candidate
	as fun-inst
		non-inferring candidate.param-types[arg-index]
	as called-spec-sig
		non-inferring candidate.param-types[arg-index]
	as full-candidate
		decl-type = candidate.variadic-type else candidate.called.param-types[arg-index]
		tc = type-and-maybe-context decl-type, candidate.inferring-type-args
		if instantiated = get-exact-non-inferring-type tc
			non-inferring instantiated
		else
			tc

candidate-bogus-called called(candidate candidate)
	:: called-bogus
	decl: candidate.called
	return-and-param-types: map candidate.called.return-and-param-types, {get-candidate-type-or-bogus candidate, it}

-get-candidate-type-or-bogus type(candidate candidate, declared-type type)
	type = type-and-maybe-context declared-type, candidate.inferring-type-args
	try-get-inexact-non-inferring-type type else bogus-type
